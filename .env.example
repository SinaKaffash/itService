# Server-only. PostgreSQL connection string used by Prisma.
# Do not expose this value to the browser or commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/it_services?schema=public"

# Browser-safe. Canonical app URL used for metadata, sitemap, robots, and JSON-LD.
# Development: http://localhost:3000
# Production: use the public HTTPS origin, for example https://example.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server runtime bind settings. Optional locally; PM2 sets these in production.
PORT="3000"
HOSTNAME="127.0.0.1"

# Optional local development overrides.
# DEV_HOSTNAME controls the Next.js dev bind address; keep 0.0.0.0 for LAN/mobile testing.
# ALLOWED_DEV_ORIGINS can add extra hostnames/IPs if your browser reaches dev through a proxy.
DEV_HOSTNAME="0.0.0.0"
ALLOWED_DEV_ORIGINS=""

# Server-only. Required for signed admin JWT sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET="replace-with-a-random-value-at-least-32-characters-long"

# Seed-only server variables for `npm run db:seed`.
# These bootstrap the first SUPER_ADMIN; manage later admins inside the app.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_USERNAME="nexus-admin"
ADMIN_NAME="Site Administrator"
ADMIN_PASSWORD="replace-with-a-long-random-password"
