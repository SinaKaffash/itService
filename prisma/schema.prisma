generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum LeadRequestStatus {
  NEW
  IN_REVIEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(EDITOR)
  isActive     Boolean    @default(true)
  blogPosts    BlogPost[]
  sessions     AdminSession[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([isActive])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id            String        @id @default(cuid())
  slug          String        @unique
  translations  Json
  icon          String?
  sortOrder     Int           @default(0)
  published     Boolean       @default(false)
  isActive      Boolean       @default(true)
  leadRequests  LeadRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([published, isActive, sortOrder])
}

model Portfolio {
  id            String   @id @default(cuid())
  slug          String   @unique
  translations  Json
  coverImage    String?
  gallery       Json?
  technologies  String[]
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, isActive, sortOrder])
}

model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  translations  Json
  coverImage    String?
  published     Boolean    @default(false)
  publishedAt   DateTime?
  isActive      Boolean    @default(true)
  authorId      String?
  author        AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([published, isActive, publishedAt])
  @@index([authorId])
}

model LeadRequest {
  id           String            @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  company      String?
  serviceType  String
  locale       String            @default("fa")
  budget       String?
  description  String
  status       LeadRequestStatus @default(NEW)
  serviceId    String?
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  source       String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([serviceId])
  @@index([email])
}
