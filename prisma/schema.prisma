generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

enum LeadRequestStatus {
  NEW
  IN_REVIEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ServiceHealth {
  OPERATIONAL
  DEGRADED
  OUTAGE
  MAINTENANCE
}

enum AnnouncementSeverity {
  INFO
  MAINTENANCE
  INCIDENT
}

enum TicketCategory {
  SOFTWARE
  HARDWARE
  ACCESS
  SOFTWARE_REQUEST
  NETWORK
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(EDITOR)
  isActive     Boolean    @default(true)
  blogPosts    BlogPost[]
  sessions     AdminSession[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([isActive])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String
  content       String        @default("")
  icon          String?
  sortOrder     Int           @default(0)
  published     Boolean       @default(false)
  isActive      Boolean       @default(true)
  leadRequests  LeadRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([published, isActive, sortOrder])
}

model Portfolio {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String
  category      String   @default("")
  content       String   @default("")
  coverImage    String?
  gallery       Json?
  technologies  String[]
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, isActive, sortOrder])
}

model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  description   String
  category      String     @default("")
  content       String     @default("")
  coverImage    String?
  published     Boolean    @default(false)
  publishedAt   DateTime?
  isActive      Boolean    @default(true)
  authorId      String?
  author        AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([published, isActive, publishedAt])
  @@index([authorId])
}

model LeadRequest {
  id           String            @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  company      String?
  serviceType  String
  budget       String?
  description  String
  status       LeadRequestStatus @default(NEW)
  serviceId    String?
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  source       String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([serviceId])
  @@index([email])
}

model Project {
  id String @id @default(cuid())
  title String
  description String
  progress Int @default(0)
  status ProjectStatus @default(PLANNED)
  startDate DateTime?
  expectedEndDate DateTime?
  completedAt DateTime?
  published Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, isActive, status, sortOrder])
}

model ItServiceStatus {
  id String @id @default(cuid())
  name String
  description String @default("")
  health ServiceHealth @default(OPERATIONAL)
  published Boolean @default(false)
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  lastUpdatedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, isActive, sortOrder])
}

model Announcement {
  id String @id @default(cuid())
  title String
  body String
  severity AnnouncementSeverity @default(INFO)
  publishAt DateTime @default(now())
  expiresAt DateTime?
  pinned Boolean @default(false)
  published Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, isActive, publishAt, expiresAt])
}

model SupportTicket {
  id String @id @default(cuid())
  trackingCode String @unique
  requesterName String
  email String
  phone String?
  category TicketCategory
  title String
  description String
  priority TicketPriority @default(MEDIUM)
  status TicketStatus @default(NEW)
  internalNotes String @default("")
  resolvedAt DateTime?
  attachments TicketAttachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([email, trackingCode])
}

model TicketAttachment {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  originalName String
  storageName String @unique
  mimeType String
  size Int
  createdAt DateTime @default(now())
  @@index([ticketId])
}
